#!/usr/bin/env python3
"""thermallog - record CPU/GPU thermals under load, report peaks on exit.

  thermallog [interval]        default 5s, ctrl-c to stop and print summary
  thermallog 5 > run.csv       CSV to file, summary to stderr

Columns: time, cpu%, pkg°C, maxcore°C, MHz, throttle_events, gpu%, gpu°C, gpuW, ram_GiB
"""
import sys, time, glob, json, shutil, subprocess, re, signal

INTERVAL = float(sys.argv[1]) if len(sys.argv) > 1 and sys.argv[1].replace(".", "", 1).isdigit() else 5.0
HAS_SENSORS = shutil.which("sensors") is not None


def read(p, d=None):
    try:
        with open(p) as fh:
            return fh.read().strip()
    except Exception:
        return d


def temps():
    if HAS_SENSORS:
        try:
            r = subprocess.run(["sensors", "-j"], capture_output=True, text=True, timeout=4)
            if r.returncode == 0:
                try:
                    raw = json.loads(r.stdout)
                except json.JSONDecodeError:
                    raw = json.loads(re.sub(r",(\s*[}\]])", r"\1", r.stdout))
                pkg = mx = 0.0
                for chip, body in raw.items():
                    if not chip.startswith("coretemp") or not isinstance(body, dict):
                        continue
                    for lab, f in body.items():
                        if not isinstance(f, dict):
                            continue
                        v = next((x for k, x in f.items()
                                  if k.endswith("_input") and isinstance(x, (int, float))), None)
                        if v is None:
                            continue
                        if "Package" in lab:
                            pkg = float(v)
                        elif lab.startswith("Core"):
                            mx = max(mx, float(v))
                return pkg, mx
        except Exception:
            pass
    best = [0.0, 0.0]
    for d in glob.glob("/sys/class/hwmon/hwmon*"):
        if read(f"{d}/name") != "coretemp":
            continue
        for f in glob.glob(f"{d}/temp*_input"):
            lab = read(f[:-6] + "_label") or ""
            v = int(read(f, 0)) / 1000.0
            if "Package" in lab:
                best[0] = v
            elif lab.startswith("Core"):
                best[1] = max(best[1], v)
    return best[0], best[1]


def cpu_times():
    v = [int(x) for x in read("/proc/stat", "").split("\n")[0].split()[1:]]
    return sum(v), v[3] + v[4]


def freq():
    f = [int(x) for x in (read(p) for p in
         glob.glob("/sys/devices/system/cpu/cpu*/cpufreq/scaling_cur_freq")) if x]
    return sum(f) / len(f) / 1000 if f else 0


def throttle():
    c = read("/sys/devices/system/cpu/cpu0/thermal_throttle/package_throttle_count")
    return int(c) if c else 0


def gpu():
    try:
        r = subprocess.run(["nvidia-smi",
                            "--query-gpu=utilization.gpu,temperature.gpu,power.draw",
                            "--format=csv,noheader,nounits"],
                           capture_output=True, text=True, timeout=4)
        a = [x.strip() for x in r.stdout.strip().split("\n")[0].split(",")]
        return float(a[0]), float(a[1]), float(a[2])
    except Exception:
        return 0.0, 0.0, 0.0


def ram_gib():
    m = {}
    for line in read("/proc/meminfo", "").split("\n"):
        p = line.split(":")
        if len(p) == 2:
            m[p[0]] = int(p[1].split()[0]) * 1024
    return (m.get("MemTotal", 0) - m.get("MemAvailable", 0)) / 2**30


peak = {"pkg": 0.0, "core": 0.0, "cpu": 0.0, "mhz": 0.0,
        "gpu": 0.0, "gput": 0.0, "gpuw": 0.0, "ram": 0.0}
thr0 = throttle()
samples = 0
t_start = time.time()
pc, pi_ = cpu_times()

print("time,cpu_pct,pkg_C,maxcore_C,MHz,throttle_events,gpu_pct,gpu_C,gpu_W,ram_GiB", flush=True)


def summary(*_):
    el = time.time() - t_start
    thr = throttle() - thr0
    out = sys.stderr
    print(f"\n{'='*54}", file=out)
    print(f"THERMAL SUMMARY  ({el/60:.1f} min, {samples} samples, {INTERVAL}s)", file=out)
    print(f"{'='*54}", file=out)
    print(f"  CPU package peak   {peak['pkg']:6.1f} °C", file=out)
    print(f"  hottest core peak  {peak['core']:6.1f} °C", file=out)
    print(f"  CPU util peak      {peak['cpu']:6.1f} %", file=out)
    print(f"  avg freq peak      {peak['mhz']:6.0f} MHz", file=out)
    print(f"  GPU peak           {peak['gpu']:6.1f} %  {peak['gput']:.0f} °C  {peak['gpuw']:.0f} W", file=out)
    print(f"  RAM peak           {peak['ram']:6.1f} GiB", file=out)
    print(f"  throttle events    {thr:6d}"
          f"{'   <-- THERMAL LIMIT HIT' if thr else '   (none — cooling adequate)'}", file=out)
    sys.exit(0)


signal.signal(signal.SIGINT, summary)
signal.signal(signal.SIGTERM, summary)

try:
    while True:
        time.sleep(INTERVAL)
        c, i = cpu_times()
        dt, di = c - pc, i - pi_
        cpu_pct = 100.0 * (1 - di / dt) if dt else 0.0
        pc, pi_ = c, i
        pkg, core = temps()
        mhz = freq()
        gu, gt, gw = gpu()
        rg = ram_gib()
        thr = throttle() - thr0
        samples += 1
        peak.update(pkg=max(peak["pkg"], pkg), core=max(peak["core"], core),
                    cpu=max(peak["cpu"], cpu_pct), mhz=max(peak["mhz"], mhz),
                    gpu=max(peak["gpu"], gu), gput=max(peak["gput"], gt),
                    gpuw=max(peak["gpuw"], gw), ram=max(peak["ram"], rg))
        print(f"{time.strftime('%H:%M:%S')},{cpu_pct:.1f},{pkg:.1f},{core:.1f},"
              f"{mhz:.0f},{thr},{gu:.0f},{gt:.0f},{gw:.1f},{rg:.1f}", flush=True)
except KeyboardInterrupt:
    summary()
