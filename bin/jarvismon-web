#!/usr/bin/env python3
"""jarvismon-web - serves `jarvismon -1` frames over HTTP.

Read-only wrapper: shells out to jarvismon, converts its ANSI SGR output to
HTML, and serves it on 0.0.0.0:8777. Stdlib only, no deps.

  jarvismon-web [port]      default 8777
"""
import html
import re
import subprocess
import sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

PORT = int(sys.argv[1]) if len(sys.argv) > 1 else 8777
JARVISMON = "/home/ocino/.local/bin/jarvismon"

SGR = re.compile(r"\033\[([0-9;]*)m")
COLORS = {
    "30": "#5c6370", "31": "#e06c75", "32": "#98c379", "33": "#e5c07b",
    "34": "#61afef", "35": "#c678dd", "36": "#56b6c2", "37": "#dcdfe4",
    "90": "#5c6370", "91": "#e06c75", "92": "#98c379", "93": "#e5c07b",
    "94": "#61afef", "95": "#c678dd", "96": "#56b6c2", "97": "#ffffff",
}


def ansi_to_html(text):
    out = []
    open_spans = 0
    pos = 0
    for m in SGR.finditer(text):
        out.append(html.escape(text[pos:m.start()]))
        pos = m.end()
        for code in (m.group(1) or "0").split(";"):
            code = code or "0"
            if code == "0":
                out.append("</span>" * open_spans)
                open_spans = 0
            elif code == "1":
                out.append('<span style="font-weight:700">')
                open_spans += 1
            elif code == "2":
                out.append('<span style="opacity:.55">')
                open_spans += 1
            elif code in COLORS:
                out.append('<span style="color:%s">' % COLORS[code])
                open_spans += 1
    out.append(html.escape(text[pos:]))
    out.append("</span>" * open_spans)
    return "".join(out)


FRAME_CACHE = {"t": 0.0, "html": ""}
FRAME_TTL = 0.5


def frame():
    import time
    now = time.time()
    if now - FRAME_CACHE["t"] < FRAME_TTL and FRAME_CACHE["html"]:
        return FRAME_CACHE["html"]
    try:
        p = subprocess.run([JARVISMON, "-1"], capture_output=True,
                           text=True, timeout=20)
        out = ansi_to_html(p.stdout or p.stderr)
    except Exception as e:
        return html.escape("jarvismon failed: %r" % (e,))
    FRAME_CACHE["t"] = now
    FRAME_CACHE["html"] = out
    return out


PAGE = """<!doctype html>
<html lang="sk"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>jarvismon</title>
<style>
 :root { color-scheme: dark; }
 body { margin:0; background:#16181d; color:#dcdfe4;
        font:13px/1.45 ui-monospace,"JetBrains Mono",Menlo,Consolas,monospace; }
 header { padding:10px 16px; border-bottom:1px solid #2a313c;
          display:flex; gap:14px; align-items:baseline; flex-wrap:wrap; }
 h1 { margin:0; font-size:14px; font-weight:700; letter-spacing:.02em; }
 #meta { opacity:.55; font-size:12px; }
 #err { color:#e06c75; }
 pre { margin:0; padding:16px; white-space:pre; overflow-x:auto; }
 label { opacity:.55; font-size:12px; }
</style></head><body>
<header>
  <h1>jarvismon</h1>
  <span id="meta">192.168.100.59</span>
  <label><input type="checkbox" id="live" checked> live</label>
  <label>refresh
    <select id="iv">
      <option value="1000">1s</option>
      <option value="2000">2s</option>
      <option value="5000">5s</option>
    </select>
  </label>
  <span id="err"></span>
</header>
<pre id="out">nacitavam...</pre>
<script>
const out = document.getElementById('out');
const err = document.getElementById('err');
const live = document.getElementById('live');
const iv = document.getElementById('iv');
let busy = false, timer = null;
try { iv.value = localStorage.getItem('jarvismon-iv') || '1000'; } catch (e) {}
async function tick() {
  if (busy) return;            // a slow frame must not pile up requests
  busy = true;
  try {
    const r = await fetch('/frame', {cache: 'no-store'});
    out.innerHTML = await r.text();
    err.textContent = '';
  } catch (e) { err.textContent = 'offline'; }
  busy = false;
}
function schedule() {
  if (timer) clearInterval(timer);
  timer = setInterval(() => { if (live.checked) tick(); }, Number(iv.value));
}
iv.addEventListener('change', () => {
  try { localStorage.setItem('jarvismon-iv', iv.value); } catch (e) {}
  schedule();
  tick();
});
tick();
schedule();
</script>
</body></html>
"""


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def _send(self, body, ctype):
        data = body.encode()
        self.send_response(200)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        path = self.path.split("?")[0]
        if path == "/frame":
            self._send(frame(), "text/html; charset=utf-8")
        elif path in ("/", "/index.html"):
            self._send(PAGE, "text/html; charset=utf-8")
        else:
            self.send_error(404)

    def log_message(self, *a):
        pass


if __name__ == "__main__":
    print("jarvismon-web on http://0.0.0.0:%d/" % PORT, flush=True)
    ThreadingHTTPServer(("0.0.0.0", PORT), Handler).serve_forever()
