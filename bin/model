#!/usr/bin/env bash
# model — pick a Jarvis model and bring it up end to end.
set -uo pipefail

REMOTE="${MODEL_REMOTE:-jarvis}"
TUNNEL="${MODEL_TUNNEL:-llm-tunnel}"
PI_DIR="${PI_DIR:-$HOME/.pi/agent}"
OC_DIR="${OC_DIR:-$HOME/.config/opencode}"
SSH="ssh -o BatchMode=yes -o ConnectTimeout=15"

# Same script runs on a client (drives jarvis over ssh) and on jarvis itself.
# Deploy:  scp bin/model jarvis:~/.local/bin/model  &&  ssh jarvis chmod 755 ~/.local/bin/model
IS_LOCAL=0
[[ "$(hostname 2>/dev/null)" =~ ^(jarvis|jarvis59|192\.168\.100\.59)$ ]] && IS_LOCAL=1
HOSTLBL='client -> jarvis'
[[ "$IS_LOCAL" == 1 ]] && HOSTLBL='jarvis (local)'

rsh() { # rsh '<snippet>' — one command, no args
  if [[ "$IS_LOCAL" == 1 ]]; then bash -c "$1"
  else $SSH -n "$REMOTE" "$1"; fi
}
rexec() { # rexec [args...]  — script on stdin, args as $1..$n
  if [[ "$IS_LOCAL" == 1 ]]; then bash -s -- "$@"
  else $SSH "$REMOTE" bash -s -- "$@"; fi
}

# All local models are llama.cpp GGUFs on jarvis (/mnt/models2, ~/models-27b,
# ~/models-fast, ~/models-ds), served on :8000. One serves at a time.
#
# The keys below mirror llama-swap's catalogue one for one — that is the only list
# that can actually be served. Weights that exist on disk but are NOT wired into
# llama-swap (/mnt/models2/candidates: swift, gsq-rco, huihui-abliterated,
# 0bserverx-heretic; ~/models-fast: the Flash-Next Q4/Q5/Q6/Q8 ladder) are therefore
# not listed: add them to ~/.config/llama-swap/config.yaml first.
#
# Adding a model? Read docs/model-rules.md first: wire it into llama-swap, measure
# it with bin/bench-model, then add the row. The tok/s field takes a number, not prose.
#
# Ordered fastest first. Speeds and contexts are measured (docs/evals/), generation
# tok/s at temperature 0.6.
#
# ctx is not a setting any more. llama-swap leaves -c unset and pins -ngl, so
# llama.cpp's --fit picks the largest context that still keeps every layer on the
# GPU; the numbers here are what it chose. Re-measure after changing quant, -ncmoe
# or the card. turbo is the one exception, pinned to 65536: --fit cannot see the
# MTP draft context, and turbo's 19.7 GiB of weights leave only ~3.3 GB for it.
#
# What the columns cannot say:
#   gsq-rco / heretic / turbo  MTP self-speculation — that is why they beat the
#                              plain 27B quants despite being the same size class
#   ocr-vlm                    needs the mmproj file; 8k ctx only
#   q38-*                      Flash-Next experts spill to RAM and disk, so speed
#                              swings ±20% with page cache. Prefill is the real
#                              problem: 13-19 tok/s, so long prompts are painful
#   dsv4-q8                    prefill 6 tok/s — a 16k prompt takes ~45 min
#
# llama-swap also serves "q38-27b-q5" (planner's weights at 100k ctx, kept so older
# scripts keep resolving) and every ":fast" alias (same model, thinking off). Neither
# needs a row here: they are not different models.
# Thinking levels were picked by eval, not taste: lowest level that still answers
# multi-step questions correctly, because the priority here is speed.
# The 52 tok/s figure needs --spec-type draft-mtp, which only the llama-swap entry
# passes; a start_direct fallback runs the same file at ~34 tok/s.
#
# Since 2026-09-20 :8000 is llama-swap, a router that holds the whole catalogue and
# loads a model on demand (exclusive group = everything else unloads). When it is up
# this script does not start anything: it warms the id and points the clients at it.
# The llama.service / start_direct paths below are the fallback for a box without it.
#
# rec: key | name | quant | size | n-cpu-moe | tok/s | path/id | ctx | ngl (blank = 99/full) | reasoning (blank = template default; on/off/auto -> --reasoning, else -> --reasoning-effort) | chat-template file (blank = GGUF built-in) | for
#
# "for" says why you would pick this one: "uncensored" when the tune is built that
# way, otherwise the job it is good at. Uncensored comes from the tune's own card
# (abliterated / heretic / uncensored in its name), NOT from a behaviour test —
# every model here, stock Qwen included, answered both refusal probes we tried.
# All dense qwen35 archs here have 65 blocks. The card is an RTX 3090 24 GB, so ~20 GB
# of weights is the safe full-GPU ceiling (proven by turbo at Q5_K_M); the older -ngl
# values below were sized for the 16 GB card this box used to have.
#
# huihui-abliterated and 0bserverx-heretic default their chat templates to
# reasoning_effort=xhigh (always-on, verbose thinking) — that is the slow-response
# complaint on Jarvis, not GPU speed. Pinned to "off" here so they behave like the
# other conversational models. See memory: jarvis-smart-home-build.
#
# eco is the coder weights run as a whole-session agent model: Qwen card sampling
# pinned in llama-swap, prompt-cache reuse, and on the client side opencode gets a
# 64k context cap, old-tool-output pruning and small_model = eco, so title/summary
# calls never swap the GPU to another model. tok/s and ctx are qwen3-coder-30b's
# (same file, same --fit); re-run bench-model eco after deploying.
MODELS=(
  "eco|Qwen3 Coder 30B|Q4_K_M|17.3 GiB|0|162|/mnt/models2/coder/Qwen3-Coder-30B-A3B-Instruct-Q4_K_M.gguf|99584|99|off||coding, low-token"
  "qwen3-coder-30b|Qwen3 Coder 30B|Q4_K_M|17.3 GiB|0|162|/mnt/models2/coder/Qwen3-Coder-30B-A3B-Instruct-Q4_K_M.gguf|99584|99|off||coding"
  "gsq-rco|Qwen3.8 27B GSQ-RCO|IQ3_S MTP|11.3 GiB|0|68|/mnt/models2/candidates/gsq-rco/Qwen3.8-27B-GSQ-RCO-IQ3_S-mtp.gguf|203264|99|low|/home/ocino/jarvis-files/models/templates/qwen38-27b-unsloth.jinja|fastest 27B"
  "heretic|Qwen3.8 27B Heretic|Q4_K_M MTP|15.8 GiB|0|63|/mnt/models2/candidates/0bserverx-heretic/RVN-Q4_K_M-multilingual-mtp.gguf|101120|99|low|/home/ocino/jarvis-files/models/templates/qwen38-27b-unsloth.jinja|uncensored, multilingual"
  "turbo|DavidAU Qwen3.8 27B TURBO|Q5_K_M NEO-MTP|19.7 GiB|0|51|/home/ocino/models-27b/turbo/MTP-Q5_K_M.gguf|65536|99|low||uncensored, coder"
  "ocr-vlm|Qwen3.8 27B Vision|UD-IQ4_XS|14.2 GiB|0|43|/home/ocino/models-27b/Qwen3.8-27B-UD-IQ4_XS.gguf|225536|99|off||images, OCR"
  "huihui|Huihui Qwen3.8 27B|UD-Q4_K_XL|16.2 GiB|0|39|/mnt/models2/candidates/huihui-abliterated/Huihui-Qwen3.8-27B-abliterated-UD-Q4_K_XL.gguf|180992|99|low||uncensored"
  "swift|Swift Qwen3.8 27B|Q4_K_M|16.8 GiB|0|39|/mnt/models2/candidates/swift/Swift-Qwen3.8-27B-Q4_K_M.gguf|171520|99|low||general chat"
  "planner|Qwen3.8 27B (stock)|UD-Q5_K_XL|19.4 GiB|0|34|/home/ocino/models-27b/Qwen3.8-27B-UD-Q5_K_XL.gguf|101632|99|low||reasoning, specs"
  "q38-q4|Qwen3.8 Flash-Next|UD-Q4_K_XL|~104 GB|38|16|/home/ocino/models-fast/UD-Q4_K_XL/Qwen3.8-Flash-Next-UD-Q4_K_XL-00001-of-00004.gguf|262144||low||knowledge breadth"
  "q38-q5|Qwen3.8 Flash-Next|UD-Q5_K_XL|~148 GB|42|15|/home/ocino/models-fast/UD-Q5_K_XL/Qwen3.8-Flash-Next-UD-Q5_K_XL-00001-of-00006.gguf|243968||low||knowledge breadth"
  "q38-iq3x|Qwen3.8 Flash-Next|UD-IQ3_XXS|~77 GB|32|11|/mnt/models2/UD-IQ3_XXS/Qwen3.8-Flash-Next-UD-IQ3_XXS-00001-of-00003.gguf|124416||low||knowledge breadth"
  "q38-q2|Qwen3.8 Flash-Next|UD-Q2_K_XL|~74 GB|30|9|/mnt/models2/UD-Q2_K_XL/Qwen3.8-Flash-Next-UD-Q2_K_XL-00001-of-00003.gguf|262144||low||knowledge breadth"
  "dsv4-q8|DeepSeek V4 Flash 284B|UD-Q8_K_XL|~151 GB|43|3.4|/mnt/models2/deepseek-v4/UD-Q8_K_XL/DeepSeek-V4-Flash-0731-UD-Q8_K_XL-00001-of-00005.gguf|1048576||||eval only"
)

C_OFF=$'\e[0m'; C_DIM=$'\e[2m'; C_B=$'\e[1m'; C_G=$'\e[32m'; C_Y=$'\e[33m'; C_R=$'\e[31m'; C_C=$'\e[36m'
[[ -t 1 ]] || { C_OFF=; C_DIM=; C_B=; C_G=; C_Y=; C_R=; C_C=; }

die()  { printf '%serror:%s %s\n' "$C_R" "$C_OFF" "$*" >&2; exit 1; }
info() { printf '%s\n' "$*"; }

# rec fields: 1 key  2 name  3 quant  4 size  5 n-cpu-moe  6 fit-note  7 path/id  8 ctx  9 ngl  10 reasoning  11 chat-template
field() { # field <key> <index 1-11>
  local rec f
  for rec in "${MODELS[@]}"; do
    [[ "${rec%%|*}" == "$1" ]] || continue
    IFS='|' read -r -a f <<<"$rec"
    printf '%s' "${f[$(($2 - 1))]:-}"
    return 0
  done
  return 1
}
keys() { local rec; for rec in "${MODELS[@]}"; do printf '%s\n' "${rec%%|*}"; done; }
fmt_ctx() { # 262144 -> 262k, 1048576 -> 1.0M
  local c="${1:-0}"
  [[ "$c" =~ ^[0-9]+$ ]] || { printf '%s' "-"; return; }
  if ((c >= 1000000)); then awk -v c="$c" 'BEGIN{printf "%.1fM", c/1000000}'
  else printf '%dk' $((c / 1000)); fi
}
valid_key() { keys | grep -qx -- "$1"; }

# ---------- what is actually serving :8000 ----------

swap_active() { # is llama-swap the thing on :8000?
  [[ -n "${SWAP_STATE:-}" ]] ||
    SWAP_STATE=$(rsh 'systemctl --user is-active llama-swap.service 2>/dev/null' 2>/dev/null)
  [[ "$SWAP_STATE" == active ]]
}
swap_json() { rsh "curl -sf -m 4 http://127.0.0.1:8000/v1/models" 2>/dev/null; }

# probe() sets ACTIVE (a model key, or "" for nothing, or "unknown:<id>").
# Endpoint-based: ask :8000 what it serves and map the alias back to a key.
# No process-name guessing — that is what used to put a phantom dot on dsv4.
# llama-swap advertises its whole catalogue, so the answer is the entry whose
# status is "loaded", not the first id in the list.
probe() {
  ACTIVE=""
  local json served
  json=$(swap_json)
  [[ -z "$json" ]] && return 0
  if [[ "$json" == *'"status"'* ]] && command -v jq >/dev/null; then
    served=$(jq -r 'first(.data[] | select(.status.value == "loaded") | .id) // ""' <<<"$json" 2>/dev/null)
  else
    served=$(grep -o '"id":"[^"]*"' <<<"$json" | head -1 | cut -d'"' -f4)
  fi
  [[ -z "$served" ]] && return 0
  case "$served" in
    qwen38|qwen3.8-flash-next)                 ACTIVE=q38-q2 ;;
    *) if valid_key "$served"; then ACTIVE=$served; else ACTIVE="unknown:$served"; fi ;;
  esac
}
active_label() { # pretty text for $ACTIVE
  case "$ACTIVE" in
    "")        printf 'nothing on :8000' ;;
    unknown:*) printf '%s (unrecognised)' "${ACTIVE#unknown:}" ;;
    *)         printf '%s  %s %s' "$ACTIVE" "$(field "$ACTIVE" 2)" "$(field "$ACTIVE" 3)" ;;
  esac
}

# ---------- tunnel ----------

tunnel_up() {
  [[ "$IS_LOCAL" == 1 ]] && return 0
  pgrep -f "ssh .*-N.*(llm-tunnel|jarvis-tunnel)" >/dev/null 2>&1 && return 0
  ss -ltn 2>/dev/null | grep -qE '127\.0\.0\.1:(8000|11434)'
}
ensure_tunnel() {
  [[ "$IS_LOCAL" == 1 ]] && { info "  tunnel      not needed (running on jarvis)"; return 0; }
  tunnel_up && { info "  tunnel      up (8000, 11434)"; return 0; }
  ssh -N -f -o BatchMode=yes -o ExitOnForwardFailure=yes "$TUNNEL" 2>/dev/null &&
    info "  tunnel      started (8000, 11434)" ||
    printf '  %stunnel      failed — run manually: ssh -N %s%s\n' "$C_Y" "$TUNNEL" "$C_OFF"
}

# ---------- client config (pi + opencode) ----------

# Both configs are generated from MODELS — one source of truth, no drift.
write_pi_config() { # write_pi_config <key>
  local key="$1" model_id="$1"
  [[ -d "$PI_DIR" ]] || { printf '  %spi          %s not present, skipped%s\n' "$C_DIM" "$PI_DIR" "$C_OFF"; return 0; }
  command -v jq >/dev/null || { printf '  %spi          jq missing, skipped%s\n' "$C_Y" "$C_OFF"; return 0; }

  local models='[]' rec rkey rname rquant
  for rec in "${MODELS[@]}"; do
    IFS='|' read -r rkey rname rquant _ _ _ _ <<<"$rec"
    models=$(jq --arg i "$rkey" --arg n "$rname $rquant" \
      '. += [{id:$i, name:$n, provider:"llamacpp"}]' <<<"$models")
  done
  local tmp; tmp=$(mktemp)
  jq -n --argjson m "$models" '
    { providers: {
        llamacpp: { baseUrl:"http://localhost:8000/v1", api:"openai-completions", apiKey:"local",
                    models: ($m | map({id:.id, name:.name})) }
      } }' >"$tmp" && mv "$tmp" "$PI_DIR/models.json" || { rm -f "$tmp"; printf '  %spi          gen failed%s\n' "$C_Y" "$C_OFF"; return 1; }

  local s="$PI_DIR/settings.json"; [[ -f "$s" ]] || echo '{}' >"$s"
  tmp=$(mktemp)
  jq --arg m "$model_id" '.defaultProvider="llamacpp" | .defaultModel=$m' "$s" >"$tmp" && mv "$tmp" "$s"
  info "  pi          default -> llamacpp / $model_id"
}

write_opencode_config() { # write_opencode_config <key>
  # Merges into opencode.json rather than overwriting it — preserves any
  # hand-added providers (e.g. colibri, ollama) and agent blocks.
  command -v opencode >/dev/null || [[ -d "$OC_DIR" ]] || { return 0; }
  command -v jq >/dev/null || { printf '  %sopencode    jq missing, skipped%s\n' "$C_Y" "$C_OFF"; return 0; }
  mkdir -p "$OC_DIR"
  local rec rkey rname rquant models='{}'
  for rec in "${MODELS[@]}"; do
    IFS='|' read -r rkey rname rquant _ _ _ _ <<<"$rec"
    models=$(jq --arg k "$rkey" --arg n "$rname $rquant" '. + {($k): {name:$n}}' <<<"$models")
  done
  local defmodel="llamacpp/$1"
  local f="$OC_DIR/opencode.json"
  [[ -f "$f" ]] || echo '{"$schema":"https://opencode.ai/config.json"}' >"$f"
  local tmp; tmp=$(mktemp)
  # eco's session profile is keyed on small_model == llamacpp/eco: it is set when eco
  # is picked and removed (with the prune it came with) when any other key is.
  jq --argjson m "$models" --arg dm "$defmodel" '
    .["$schema"] //= "https://opencode.ai/config.json"
    | .model = $dm
    | .provider.llamacpp.npm = "@ai-sdk/openai-compatible"
    | .provider.llamacpp.name //= "llama.cpp (jarvis tunnel :8000)"
    | .provider.llamacpp.options //= { baseURL:"http://localhost:8000/v1", apiKey:"local" }
    | .provider.llamacpp.models = ((.provider.llamacpp.models // {}) * $m)
    | .provider.llamacpp.models.eco.limit = { context: 65536, output: 16384 }
    | if $dm == "llamacpp/eco" then
        .small_model = $dm | .compaction.auto = true | .compaction.prune = true
      elif .small_model == "llamacpp/eco" then
        del(.small_model) | del(.compaction.prune)
        | if .compaction == {auto: true} then del(.compaction) else . end
      else . end
    | del(.provider.openrouter)
  ' "$f" >"$tmp" && mv "$tmp" "$f" \
    && info "  opencode    default -> $defmodel (merged; other providers/agents kept)" \
    || { rm -f "$tmp"; printf '  %sopencode    gen failed%s\n' "$C_Y" "$C_OFF"; }
}

# ---------- start / stop (systemd user unit + direct) ----------

stop_serving() { # stop whatever holds :8000, quietly
  rsh 'systemctl --user stop llama.service 2>/dev/null
       pkill -f "llama-server .*--port 8000" 2>/dev/null
       pkill -f "coli serve" 2>/dev/null
       for i in $(seq 1 20); do curl -sf -m2 http://127.0.0.1:8000/v1/models >/dev/null 2>&1 || break; sleep 1; done
       exit 0' 2>/dev/null
}

start_unit() { # start q38-q2 via its systemd user unit
  rexec <<'EOS'
set -u
systemctl --user start llama.service || { echo DIED; echo "systemctl --user start llama.service failed"; exit 1; }
for i in $(seq 1 180); do
  curl -sf -m 3 http://127.0.0.1:8000/health >/dev/null 2>&1 && { echo; echo READY; exit 0; }
  systemctl --user is-active llama.service >/dev/null 2>&1 || { echo; echo DIED; journalctl --user -u llama.service -n 15 --no-pager; exit 1; }
  printf '.'; sleep 5
done
echo; echo TIMEOUT; journalctl --user -u llama.service -n 15 --no-pager; exit 1
EOS
}

start_direct() { # start_direct <gguf> <n-cpu-moe> <alias> <ctx> <ngl> <reasoning> <chat-template>
  rexec "$1" "$2" "$3" "$4" "$5" "${6:-}" "${7:-}" <<'EOS'
set -u
GGUF=$1; MOE=$2; ALIAS=$3; CTX=${4:-32768}; NGL=${5:-99}; REASONING=${6:-}; TPL=${7:-}
LOG="$HOME/logs/model-$ALIAS.log"; mkdir -p ~/logs
BIN=~/llama.cpp/build-cuda/bin/llama-server
[ -x "$BIN" ] || { echo "MISSING: $BIN"; exit 1; }
[ -f "$GGUF" ] || { echo "MISSING: $GGUF"; exit 1; }
EXTRA=()
if [ "${MOE:-0}" -gt 0 ] 2>/dev/null; then
  EXTRA+=(--n-cpu-moe "$MOE")            # MoE experts spill to RAM
else
  EXTRA+=(--cache-type-k q8_0 --cache-type-v q8_0)   # dense: shrink KV; partial -ngl spills rest to RAM
fi
case "$REASONING" in
  "") ;;
  on | off | auto) EXTRA+=(--reasoning "$REASONING") ;;
  *) EXTRA+=(--reasoning-effort "$REASONING") ;;
esac
if [ -n "$TPL" ]; then [ -f "$TPL" ] || { echo "MISSING: $TPL"; exit 1; }; EXTRA+=(--chat-template-file "$TPL"); fi
setsid "$BIN" -m "$GGUF" -ngl "$NGL" "${EXTRA[@]}" \
  -t 24 -c "$CTX" --parallel 1 --jinja -b 2048 -ub 512 \
  --host 127.0.0.1 --port 8000 --alias "$ALIAS" \
  </dev/null >"$LOG" 2>&1 &
disown 2>/dev/null
for i in $(seq 1 240); do
  curl -sf -m 3 http://127.0.0.1:8000/health >/dev/null 2>&1 && { echo; echo READY; exit 0; }
  pgrep -f "llama-server .*--port 8000" >/dev/null 2>&1 || { echo; echo DIED; tail -20 "$LOG"; exit 1; }
  printf '.'; sleep 5
done
echo; echo TIMEOUT; tail -20 "$LOG"; exit 1
EOS
}

# ---------- commands ----------

cmd_list() {
  probe
  printf '\n%s%-27s %-15s %-9s %7s %6s  %s%s\n' "$C_B" "model" "quant" "size" "tok/s" "ctx" "for" "$C_OFF"
  printf '%s%s%s\n' "$C_DIM" "$(printf '%.0s-' {1..92})" "$C_OFF"
  local rec mark
  local -a f
  for rec in "${MODELS[@]}"; do
    IFS='|' read -r -a f <<<"$rec"
    if [[ "${f[0]}" == "$ACTIVE" ]]; then mark="${C_G}*${C_OFF}"; else mark=" "; fi
    printf '%s %s%-26s%s %-15s %-9s %s%7s%s %6s  %s%s%s\n' \
      "$mark" "$C_C" "${f[1]}" "$C_OFF" "${f[2]}" "${f[3]}" "$C_B" "${f[5]}" "$C_OFF" \
      "$(fmt_ctx "${f[7]}")" "$C_DIM" "${f[11]:-}" "$C_OFF"
  done
  printf '\n%s* = serving :8000 now   ·   tok/s = measured generation, fastest first   ·   ctx = tokens%s\n\n' "$C_DIM" "$C_OFF"
}

cmd_status() {
  probe
  printf '\n%s%s%s\n' "$C_B" "$HOSTLBL" "$C_OFF"
  printf '  serving    '
  if [[ -z "$ACTIVE" ]]; then printf '%snothing on :8000%s\n' "$C_Y" "$C_OFF"
  else printf '%s%s%s\n' "$C_G" "$(active_label)" "$C_OFF"; fi
  if [[ "$IS_LOCAL" == 1 ]]; then
    printf '  tunnel     %sn/a (on jarvis)%s\n' "$C_DIM" "$C_OFF"
  else
    printf '  tunnel     '; tunnel_up && printf '%sup%s\n' "$C_G" "$C_OFF" || printf '%sdown%s\n' "$C_Y" "$C_OFF"
  fi
  printf '  service    '
  if swap_active; then printf 'llama-swap (active)\n'
  else rsh 'systemctl --user is-active llama.service 2>/dev/null; true'; fi
  if [[ -f "$PI_DIR/settings.json" ]] && command -v jq >/dev/null; then
    printf '  pi default '; jq -r '"\(.defaultProvider // "?") / \(.defaultModel // "?")"' "$PI_DIR/settings.json"
  fi
  if [[ -f "$OC_DIR/opencode.json" ]] && command -v jq >/dev/null; then
    printf '  opencode   '; jq -r '.model // "?"' "$OC_DIR/opencode.json"
  fi
  echo
}

cmd_sync() {
  probe
  if [[ -z "$ACTIVE" ]]; then
    info "Nothing serving :8000 — nothing to sync."
    return 0
  fi
  if [[ "$ACTIVE" == unknown:* ]]; then
    printf '  %sserving %s is not a recognised model key — leaving pi/opencode config untouched.%s\n' \
      "$C_Y" "${ACTIVE#unknown:}" "$C_OFF"
    return 1
  fi

  local oc_current="" pi_current=""
  [[ -f "$OC_DIR/opencode.json" ]] && command -v jq >/dev/null &&
    oc_current=$(jq -r '.model // ""' "$OC_DIR/opencode.json" 2>/dev/null)
  [[ -f "$PI_DIR/settings.json" ]] && command -v jq >/dev/null &&
    pi_current=$(jq -r '.defaultModel // ""' "$PI_DIR/settings.json" 2>/dev/null)

  local want="llamacpp/$ACTIVE"
  local oc_ok=1 pi_ok=1
  [[ -f "$OC_DIR/opencode.json" ]] && [[ "$oc_current" != "$want" ]] && oc_ok=0
  [[ -f "$PI_DIR/settings.json" ]] && [[ "$pi_current" != "$ACTIVE" ]] && pi_ok=0
  if [[ "$oc_ok" == 1 && "$pi_ok" == 1 ]]; then
    info "In sync: :8000 is serving $(active_label), config already matches."
    return 0
  fi

  printf '%sDrift detected%s — :8000 is serving %s but config points elsewhere (opencode: %s, pi: %s).\n' \
    "$C_Y" "$C_OFF" "$ACTIVE" "${oc_current:-unset}" "${pi_current:-unset}"
  ensure_tunnel
  write_pi_config "$ACTIVE"
  write_opencode_config "$ACTIVE"
  info "Reconciled to $ACTIVE."
}

cmd_stop() {
  probe
  [[ -z "$ACTIVE" ]] && { info "Nothing serving :8000."; }
  if swap_active; then
    info "Unloading (llama-swap keeps routing; the GPU is released)..."
    rsh "curl -sf -m 60 -o /dev/null http://127.0.0.1:8000/unload" 2>/dev/null
  else
    info "Stopping (llama.service + any llama-server on :8000)..."
    stop_serving
  fi
  probe
  [[ -z "$ACTIVE" ]] && info "Stopped." || info "Still up: $(active_label)"
}

cmd_logs() {
  local t='journalctl --user -u llama.service -n 80 -f'
  [[ "$IS_LOCAL" == 1 ]] && bash -c "$t" || $SSH -t "$REMOTE" "$t"
}

pick() {
  local rec key name quant size fit line choice
  local -a lines=() ks=()
  probe
  local idx=0
  local -a f
  for rec in "${MODELS[@]}"; do
    IFS='|' read -r -a f <<<"$rec"
    local mark=" "; [[ "${f[0]}" == "$ACTIVE" ]] && mark="*"
    # field 1 is the key and stays hidden — the list itself shows model names only
    lines+=("$(printf '%d\t%s %-26s %-15s %-9s %5s tok/s %6s ctx  %s' \
      "$idx" "$mark" "${f[1]}" "${f[2]}" "${f[3]}" "${f[5]}" "$(fmt_ctx "${f[7]}")" "${f[11]:-}")")
    ks+=("${f[0]}")
    idx=$((idx + 1))
  done
  if command -v fzf >/dev/null && [[ -t 0 && -t 1 ]]; then
    line=$(printf '%s\n' "${lines[@]}" | fzf --ansi --height=~14 --reverse --no-multi \
        --delimiter=$'\t' --with-nth=2.. \
        --prompt='model> ' --header='* = serving now   ·   enter = switch, esc = cancel') || return 1
    PICK="${ks[${line%%$'\t'*}]}"
  else
    echo; printf '%sModels%s\n\n' "$C_B" "$C_OFF"
    local i=1; for line in "${lines[@]}"; do printf '  %2d) %s\n' "$i" "${line#*$'\t'}"; i=$((i + 1)); done; echo
    read -r -p "Pick [1-${#ks[@]}], q to quit: " choice
    [[ "$choice" == q || -z "$choice" ]] && return 1
    [[ "$choice" =~ ^[0-9]+$ ]] && ((choice >= 1 && choice <= ${#ks[@]})) || die "bad choice: $choice"
    PICK="${ks[$((choice - 1))]}"
  fi
  [[ -n "${PICK:-}" ]] || return 1
}

activate() { # activate <key>
  local key="$1" name quant moe path ctx reasoning tpl
  name=$(field "$key" 2); quant=$(field "$key" 3); moe=$(field "$key" 5)
  path=$(field "$key" 7); ctx=$(field "$key" 8); ngl=$(field "$key" 9); reasoning=$(field "$key" 10); tpl=$(field "$key" 11)

  probe
  if [[ "$ACTIVE" == "$key" ]]; then
    info ""; info "$name $quant is already serving :8000."
    ensure_tunnel; write_pi_config "$key"; write_opencode_config "$key"; done_banner "$key"; return 0
  fi

  if swap_active; then swap_switch "$key" "$name" "$quant"; return $?; fi

  if [[ -n "$ACTIVE" && "$ASSUME_YES" != 1 ]]; then
    printf '\n%s%s is on :8000 and will be stopped.%s\n' "$C_Y" "$(active_label)" "$C_OFF"
    read -r -p "Switch to $name $quant? [y/N] " ans
    [[ "$ans" =~ ^[Yy]$ ]] || { info "Cancelled."; return 1; }
  fi

  printf '\n%sStarting %s %s%s\n' "$C_B" "$name" "$quant" "$C_OFF"
  stop_serving
  printf '  loading     '
  local out rc=0
  if [[ "$key" == q38-q2 ]]; then
    out=$(start_unit) || rc=$?
  else
    out=$(start_direct "$path" "$moe" "$key" "$ctx" "$ngl" "$reasoning" "$tpl") || rc=$?
  fi
  if [[ $rc -ne 0 ]]; then
    printf '\n%sFailed to start %s %s.%s\n\n%s\n\n' "$C_R" "$name" "$quant" "$C_OFF" "$out"
    info "Logs: model logs"; return 1
  fi
  printf '\r  loaded      %sready%s                          \n' "$C_G" "$C_OFF"
  ensure_tunnel; write_pi_config "$key"; write_opencode_config "$key"; done_banner "$key"
}

swap_switch() { # swap_switch <key> <name> <quant> — llama-swap loads on demand
  local key="$1" name="$2" quant="$3"
  if ! swap_json | grep -q "\"id\":\"$key\""; then
    printf '\n%s%s is not in the llama-swap catalogue on :8000.%s\n' "$C_R" "$key" "$C_OFF"
    info "Add it to ~/.config/llama-swap/config.yaml on jarvis — it reloads on save."
    return 1
  fi
  printf '\n%sSwitching to %s %s%s\n' "$C_B" "$name" "$quant" "$C_OFF"
  info "  runtime     llama-swap (loads on demand, unloads the rest)"
  printf '  warming     '
  if rsh "curl -sf -m 900 -o /dev/null http://127.0.0.1:8000/v1/chat/completions -H 'content-type: application/json' -d '{\"model\":\"$key\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}],\"max_tokens\":1}'"; then
    printf '\r  loaded      %sready%s                          \n' "$C_G" "$C_OFF"
  else
    printf '\r  warming     %sfailed — it will load on the first real request%s\n' "$C_Y" "$C_OFF"
  fi
  ensure_tunnel; write_pi_config "$key"; write_opencode_config "$key"; done_banner "$key"
}

done_banner() { # done_banner <key>
  local key="$1" name quant
  name=$(field "$key" 2); quant=$(field "$key" 3)
  printf '\n%s%s %s is live.%s\n\n' "$C_G" "$name" "$quant" "$C_OFF"
  printf '  opencode -m llamacpp/%s\n' "$key"
  printf '  pi --provider llamacpp --model %s\n' "$key"
  printf '  %s(both are now the default)%s\n\n' "$C_DIM" "$C_OFF"
}

usage() {
  cat <<EOF
model — pick a Jarvis model and bring it up

  model              interactive picker
  model <key>        switch straight to that model
  model list         show models (* = serving :8000)
  model status       what is serving, tunnel, pi/opencode default
  model stop         unload the running model (llama-swap), or stop llama.service
  model logs         follow llama.service journal
  model tunnel       ensure the local ssh tunnel is up
  model sync         reconcile pi/opencode config to whatever is actually serving :8000

  -y, --yes          do not prompt before switching
  -h, --help         this

Keys: $(keys | tr '\n' ' ')
EOF
}

# ---------- main ----------

ASSUME_YES=0; ARGS=()
for a in "$@"; do
  case "$a" in
    -y | --yes) ASSUME_YES=1 ;;
    -h | --help) usage; exit 0 ;;
    *) ARGS+=("$a") ;;
  esac
done

cmd="${ARGS[0]:-}"
case "$cmd" in
  "")                    pick && activate "$PICK" ;;
  list | ls | -l)        cmd_list ;;
  info)                  valid_key "${ARGS[1]:-}" || die "usage: model info <key>"
                         printf '%s\t%s\t%s\t%s\n' "$(field "${ARGS[1]}" 2)" \
                           "$(field "${ARGS[1]}" 3)" "$(field "${ARGS[1]}" 4)" "$(field "${ARGS[1]}" 8)" ;;
  status | st)           cmd_status ;;
  stop)                  cmd_stop ;;
  logs | log)            cmd_logs ;;
  tunnel)                ensure_tunnel ;;
  sync)                  cmd_sync ;;
  *)
    valid_key "$cmd" || { printf '%sunknown model or command: %s%s\n\n' "$C_R" "$cmd" "$C_OFF"; usage; exit 1; }
    activate "$cmd" ;;
esac
